rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection - stores user profile data
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // User's workbooks
    match /users/{userId}/workbooks/{workbookId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // User's problems
    match /users/{userId}/problems/{problemId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // User's study records
    match /users/{userId}/studyRecords/{recordId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // User's AI-generated explanations
    match /users/{userId}/explanations/{explanationId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
